# ---------------------------------------------------------------
# ShopMind API configuration. Copy to .env and fill in real values.
# Never commit .env — it is git-ignored.
# ---------------------------------------------------------------

# --- AI (Anthropic Claude) ---
# Create a key at https://platform.claude.com/settings/keys
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Default is claude-opus-5-5. claude-sonnet-5-5 is a cheaper alternative.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = faster & cheaper)
AI_EFFORT=medium
# Re-run requests the model declines on a fallback model (server-side).
AI_FALLBACKS=true

# Optional alternative provider:
# AI_PROVIDER=groq
# GROQ_API_KEY=...
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Security ---
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Comma-separated list of allowed browser origins (required in production)
CORS_ORIGINS=http://localhost:5173
# Set true when behind a proxy/load balancer (Render, Fly, Nginx)
TRUST_PROXY=false
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true

# --- Rate limits ---
RATE_CHAT_PER_MIN=20
RATE_API_PER_MIN=300
RATE_AUTH_PER_15MIN=20
PENDING_ACTION_TTL_HOURS=24

# --- Database ---
DATABASE_URL=postgres://postgres:shop@localhost:5432/shopmind
DB_POOL_MAX=10

PORT=4000
NODE_ENV=development
